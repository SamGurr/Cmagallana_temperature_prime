# 1. Create the survival object and fit the Kaplan-Meier model
surv_object <- Surv(time = lung$time, event = lung$status)
fit <- survfit(surv_object ~ 1, data = lung)
# 2. View survival probabilities as percentages in a summary table
summary_table <- summary(fit)
percent_surv <- summary_table$surv * 100
time_points <- summary_table$time
# Combine into a clean data frame
data.frame(Time = time_points, Percent_Survival = percent_surv)
# 3. Plot the survival curve with the Y-axis shown as percentages
# Using base R
plot(fit, yscale = 100, main = "Survival Curve (%)", ylab = "Survival Probability (%)")
# Using the ggsurvplot function from the survminer package
ggsurvplot(fit, data = lung, surv.scale = "percent")
x <- (df_binary_1wk %>% dplyr::filter(!Days>4))
