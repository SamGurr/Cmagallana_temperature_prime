dplyr::mutate(Family_ID = NA) %>%
dplyr::select(Tube.ID, Family_ID, Timepoint, Prime_treatment, Tank_number, Fixative)
all.16s <- rbind(baseline_samples.16S, samples.16S)
write.csv(all.16s, "../Data/Sequencing/16S_samples.csv")
Rmisc::summarySE(all.16s, Timepoint)
# objective, target 50 total samples.
# omit the 3 samples post prime for each of the prime treatments that were used for the 24 hour challenge.
# tanks 6, 9, and 20 for the  0 hour  prime treatment at timepoint post prime ( N = 3)
# tanks 19, 25, and 30 for the 24 hours prime treatment at timepoint post prime  ( N = 3)
# tanks 18, 24, 27 for the 72 hour prime treatmnet at timepoint post prime   ( N = 3)
TagSeq_samples <- DNARNA.samples.metadata %>%
dplyr::filter(!Prime_treatment %in% "6_hours")
TagSeq_samples %>%
dplyr::group_by(Prime_treatment, Timepoint, Tank_number) %>%
dplyr::summarise(n = n())
TagSeq_samples
write.csv(TagSeq_samples, "../Data/Sequencing/TagSeq_samples.csv")
