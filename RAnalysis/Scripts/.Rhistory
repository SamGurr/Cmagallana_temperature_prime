summarise(n = n())
# number of samples per family in LN2, N = 4
baseline_samples %>%
dplyr::filter(Fixative %in% 'LN2') %>%
dplyr::group_by(Family_ID) %>%
dplyr::summarise(n=n())
# number of samples per family in DNA RNMA shield, N = 3
