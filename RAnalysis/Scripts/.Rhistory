baseline_samples <- samples %>% dplyr::filter(Timepoint %in% 'baseline')
samples_metadata <- merge(metadata,
(samples %>% dplyr::filter(!Timepoint %in% 'baseline')),
by = 'Tank_number')
nrow(samples_metadata) == (nrow(samples) - nrow(baseline_samples))
# View(samples)
