hormetic_curve <-  ggplot( SummaryStats.Treatment,
aes(x=Treatment_asnum, y=PercSurv)) +
geom_point() +
geom_errorbar(
aes(ymin = PercSurv - se, ymax = PercSurv + se),
width = 0.2,
linewidth = 0.8
) +
geom_smooth(method = "loess") +
# scale_color_manual(values=c("green4", "darkorange1", "purple"))+
theme(legend.position="right", legend.direction="vertical",
legend.title = element_blank())+ theme_bw() +
labs(x="Dose",
y="Response")+ #scale_y_continuous(breaks=seq(0,100,20))+
ggtitle("Hormetic effect") +
theme(panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
panel.background = element_blank(),
axis.line = element_line(colour = "black")) +
facet_wrap(~Days, scales = "free_y")
